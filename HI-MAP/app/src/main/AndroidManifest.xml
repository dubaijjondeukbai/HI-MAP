<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 지도 타일과 경로를 받는 데 쓴다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 차량용 기기가 아니어도 설치되게 해서 일반 에뮬레이터에서도 시연할 수 있다 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- 안드로이드 기본 음성 합성 엔진을 찾을 수 있게 한다(demo 빌드의 예고 음성). 안드로이드 11부터 필요하다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyDrawingMap">

        <!-- 주행 제한 상태(CarUxRestrictions)를 읽는 차량용 라이브러리. 없는 기기에서도 앱은 켜진다. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan">

            <!-- 주행 중에도 화면을 띄울 수 있게 주의 분산 최적화(DO) 앱임을 알린다.
                 주행 중에는 보기 전용 화면만 보여 주고 편집을 잠근다(MainActivity.onDrivingChanged). -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
